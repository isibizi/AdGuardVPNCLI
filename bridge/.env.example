# ---------------------------------------------------------------------------
# AdGuard VPN -> WireGuard Bridge
# Kopiere diese Datei nach `.env` und passe mindestens WG_ENDPOINT und
# PANEL_PASSWORD an.
# ---------------------------------------------------------------------------

# Öffentliche IP oder DNS-Name deines VPS. Steht so im Endpoint jeder
# WireGuard-Config, die das Panel erzeugt. PFLICHTFELD.
WG_ENDPOINT=

# Passwort für das Web-Panel. Wird beim ersten Start gehasht abgelegt.
# Leer lassen, um das Passwort stattdessen im Setup-Assistenten zu vergeben.
PANEL_PASSWORD=

# --- Image -----------------------------------------------------------------
# Welches Image gezogen wird. `latest` folgt dem master-Branch; für einen festen
# Stand einen sha-Tag eintragen, z. B. BRIDGE_TAG=sha-1a2b3c4.
# Wird nur von docker-compose.yml benutzt, nicht beim Selbstbauen.
BRIDGE_TAG=latest

# --- Ports -----------------------------------------------------------------
# UDP-Port, auf dem WireGuard erreichbar ist (muss in der VPS-Firewall offen sein).
WG_PORT=51820
# Lokaler Port des Panels auf dem VPS (nur auf 127.0.0.1 gebunden).
PANEL_PORT=8080

# --- WireGuard -------------------------------------------------------------
# Adressbereich des Tunnels. 10.8.0.1 ist immer die Bridge selbst.
WG_SUBNET=10.8.0.0/24
# MTU für die Clients. Bei Problemen mit großen Seiten/Downloads auf 1280 senken.
WG_MTU=1380
# DNS-Server, die in die Client-Configs geschrieben werden (AdGuard DNS).
# Hinweis: UniFi ignoriert die DNS-Zeile importierter Configs - dort musst du
# den DNS-Server zusätzlich in den Netzwerkeinstellungen setzen.
PEER_DNS=94.140.14.14,94.140.15.15

# --- AdGuard VPN -----------------------------------------------------------
# Standort, zu dem beim Start verbunden wird. Land, Stadt oder ISO-Code,
# z. B. DE, Frankfurt, Switzerland. `fastest` = schnellster Standort.
# Im Panel jederzeit änderbar; die dortige Auswahl hat Vorrang.
ADGUARD_LOCATION=fastest
# auto | http2 | quic
ADGUARD_PROTOCOL=auto
# Wenn der gewählte Standort mehrfach nicht erreichbar ist, einmal auf den
# schnellsten Standort ausweichen.
FALLBACK_TO_FASTEST=true

# --- Monitoring ------------------------------------------------------------
# Wie lange Bandbreiten-Verlaufsdaten aufbewahrt werden.
STATS_RETENTION_DAYS=90
# Detailprotokoll einzelner Verbindungen inkl. Zielhost. Standardmäßig AUS,
# weil das faktisch ein Surf-Protokoll deines Haushalts wäre.
CONNECTION_LOG=false
